SELECT ?iri ?label ?reviewScore
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Variant> .
  ?iri <http://example.org/reviewScore> ?iri_p0 .
  FILTER(?iri_p0 >= "0.7"^^<http://www.w3.org/2001/XMLSchema#decimal>)
  ?iri <http://example.org/label> ?label .
  OPTIONAL {
    ?iri <http://example.org/reviewScore> ?reviewScore .
  }
}
