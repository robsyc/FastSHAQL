@prefix ex:  <http://example.org/> .
@prefix var: <http://example.org/variant/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# The change taxonomy: Change > Variant > {Substitution, Deletion}, plus the
# imported structural branch Change > var:StructuralVariant > var:Inversion.
# Terms carry labels like the records do — the taxonomy is data here.

ex:Change ex:label "genomic change" .
ex:Variant ex:label "sequence variant" ; rdfs:subClassOf ex:Change .
ex:Substitution ex:label "substitution" ; rdfs:subClassOf ex:Variant .
ex:Deletion ex:label "deletion" ; rdfs:subClassOf ex:Variant .
var:StructuralVariant ex:label "structural variant" ; rdfs:subClassOf ex:Change .
var:Inversion ex:label "inversion" ; rdfs:subClassOf var:StructuralVariant .

# The records. 101 is the pinned reference; 102 and 103 are settled
# classifications; 104 is pending reclassification, asserted under both
# terms while review finishes.

ex:variant-101 a ex:Variant ;
    ex:label "unclassified change 101" ;
    ex:reviewScore 0.8 .

ex:variant-102 a ex:Substitution ;
    ex:label "KRAS G12D" ;
    ex:reviewScore 0.9 .

ex:variant-103 a ex:Substitution ;
    ex:label "PIK3CA E545K" ;
    ex:reviewScore 0.4 .

ex:variant-104 a ex:Deletion, ex:Substitution ;
    ex:label "BRCA1 exon-13 rearrangement" ;
    ex:reviewScore 0.7 .
