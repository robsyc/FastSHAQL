@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix shnex:   <http://www.w3.org/ns/shacl-node-expr#> .
@prefix graphql: <http://datashapes.org/graphql#> .
@prefix ex:      <http://example.org/> .
@prefix var:     <http://example.org/variant/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

# Variant curation registry: computed root sets over a change taxonomy.

ex:VariantRegistryApi a graphql:Schema ;
    rdfs:comment "Variant-curation registry over a genomic-change taxonomy: six terms — Change, Variant, Substitution, Deletion, plus a branch imported from a partner ontology under its own IRI prefix (structural variant, inversion) — and four variant records, one typed under two terms while its reclassification finishes. Every type is an entry point, and each root field is a different computed window over the same registry: a pinned reference record, the curators' literal watchlist, all variants through their subclass closure (spelled as the instances-of shortcut or as a hand-rolled path walk), two taxonomy branches at once with dual-typed records deduplicated, high-confidence records kept by an inline filter shape, deletions found by a hand-written SPARQL select, the taxonomy terms themselves (all of them, or only the imported prefix), and a shape that is its own class — with where filters and pagination composing on top of any of it unchanged." ;
    graphql:publicShape ex:PinnedVariantShape, ex:WatchlistVariantShape, ex:VariantShape, ex:CompositeVariantShape, ex:UnionVariantShape, ex:CuratedVariantShape, ex:DeletionVariantShape, ex:ChangeTypeShape, ex:ImportedTermShape, ex:Change .

ex:PinnedVariantShape a sh:NodeShape ;
    sh:codeIdentifier "PinnedVariant" ;
    rdfs:comment "The registry's pinned reference record — a root set of exactly one, held by a constant." ;
    sh:targetNode ex:variant-101 ;
    sh:property [
        sh:path ex:label ;
        sh:description "The record's display label." ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path ex:reviewScore ;
        sh:description "The curators' review score, from 0 to 1." ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1
    ] .

ex:WatchlistVariantShape a sh:NodeShape ;
    sh:codeIdentifier "WatchlistVariant" ;
    rdfs:comment "The curators' watchlist: records picked by hand and listed as constants — membership in no class is required or checked." ;
    sh:intent "A literal list of IRIs at sh:targetNode — the picks travel as data, so a re-pick is a shapes-graph edit, never a query change." ;
    sh:targetNode ( ex:variant-102 ex:variant-103 ex:variant-104 ) ;
    sh:property [
        sh:path ex:label ;
        sh:description "The record's display label." ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path ex:reviewScore ;
        sh:description "The curators' review score, from 0 to 1." ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1
    ] .

ex:VariantShape a sh:NodeShape ;
    sh:codeIdentifier "Variant" ;
    rdfs:comment "Every variant record, typed anywhere under the Variant branch of the taxonomy." ;
    sh:targetNode [ shnex:instancesOf ex:Variant ] ;
    sh:property [
        sh:path ex:label ;
        sh:description "The record's display label." ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path ex:reviewScore ;
        sh:description "The curators' review score, from 0 to 1." ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1
    ] .

# The same set spelled out the long way: from the taxonomy term itself, walk
# up the subclass chain (any number of steps, zero included), then step out
# through rdf:type.
ex:CompositeVariantShape a sh:NodeShape ;
    sh:codeIdentifier "CompositeVariant" ;
    rdfs:comment "The same variant records, reached by walking the taxonomy: up the subclass chain from the Variant term, then out through rdf:type." ;
    sh:targetNode [
        shnex:pathValues (
            [ sh:zeroOrMorePath [ sh:inversePath rdfs:subClassOf ] ]
            [ sh:inversePath rdf:type ]
        ) ;
        shnex:focusNode ex:Variant
    ] ;
    sh:property [
        sh:path ex:label ;
        sh:description "The record's display label." ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path ex:reviewScore ;
        sh:description "The curators' review score, from 0 to 1." ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1
    ] .

ex:UnionVariantShape a sh:NodeShape ;
    sh:codeIdentifier "UnionVariant" ;
    rdfs:comment "Records under either listed branch of the taxonomy — a set, so a record typed under both appears once." ;
    sh:intent "Two classes in one instances-of target: a union of branches, not a concatenation of results." ;
    sh:targetNode [ shnex:instancesOf ( ex:Substitution ex:Deletion ) ] ;
    sh:property [
        sh:path ex:label ;
        sh:description "The record's display label." ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path ex:reviewScore ;
        sh:description "The curators' review score, from 0 to 1." ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1
    ] .

ex:CuratedVariantShape a sh:NodeShape ;
    sh:codeIdentifier "CuratedVariant" ;
    rdfs:comment "High-confidence variant records: every variant, kept only when the review score passes an inline filter shape." ;
    sh:targetNode [
        shnex:nodes [ shnex:instancesOf ex:Variant ] ;
        shnex:filterShape [
            sh:property [
                sh:path ex:reviewScore ;
                sh:minInclusive 0.7
            ]
        ]
    ] ;
    sh:property [
        sh:path ex:label ;
        sh:description "The record's display label." ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path ex:reviewScore ;
        sh:description "The curators' review score, from 0 to 1." ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1
    ] .

# The escape hatch: any root set a SELECT can express, prefixes declared
# alongside and expanded at parse time.
ex:DeletionVariantShape a sh:NodeShape ;
    sh:codeIdentifier "DeletionVariant" ;
    rdfs:comment "Deletion records, found by a hand-written SPARQL select." ;
    sh:targetNode [
        sh:prefixes [
            sh:declare [
                sh:prefix "ex" ;
                sh:namespace "http://example.org/"^^xsd:anyURI
            ]
        ] ;
        sh:select "SELECT ?record WHERE { ?record a ex:Deletion }"
    ] ;
    sh:property [
        sh:path ex:label ;
        sh:description "The record's display label." ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path ex:reviewScore ;
        sh:description "The curators' review score, from 0 to 1." ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1
    ] .

# Root entities need not be instances of anything: this window lists the
# taxonomy's own terms, queried as data.
ex:ChangeTypeShape a sh:NodeShape ;
    sh:codeIdentifier "ChangeType" ;
    rdfs:comment "The taxonomy terms themselves: every change kind at or below Change — the root term included, as the zero-step case of the walk." ;
    sh:targetNode [
        shnex:pathValues [ sh:zeroOrMorePath [ sh:inversePath rdfs:subClassOf ] ] ;
        shnex:focusNode ex:Change
    ] ;
    sh:property [
        sh:path ex:label ;
        sh:description "The term's display label." ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

# Shape-side namespace scoping: the partner ontology's terms are kept by an
# IRI-prefix pattern on the term itself — no query-side filter involved.
ex:ImportedTermShape a sh:NodeShape ;
    sh:codeIdentifier "ImportedTerm" ;
    rdfs:comment "The imported half of the taxonomy: terms whose IRI carries the partner ontology's prefix." ;
    sh:targetNode [
        shnex:nodes [
            shnex:pathValues [ sh:zeroOrMorePath [ sh:inversePath rdfs:subClassOf ] ] ;
            shnex:focusNode ex:Change
        ] ;
        shnex:filterShape [ sh:pattern "^http://example\\.org/variant/" ]
    ] ;
    sh:property [
        sh:path ex:label ;
        sh:description "The term's display label." ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

# The shape and the class share one IRI: the type targets the instances of
# ex:Change itself, subclass-closed — no sh:targetClass, no sh:targetNode.
ex:Change a sh:ShapeClass ;
    rdfs:comment "A change record of any kind — this shape is also the class, so the type is targeted at its own instances." ;
    sh:intent "One IRI wearing two hats: the terms above hang below it in the taxonomy, and its records gather under it as the widest window." ;
    sh:property [
        sh:path ex:label ;
        sh:description "The record's display label." ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path ex:reviewScore ;
        sh:description "The curators' review score, from 0 to 1." ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1
    ] .
