SELECT ?iri ?label ?subtitle ?tag ?altLabel
WHERE {
  ?iri a <http://example.org/Thing> .
  ?iri <http://example.org/label> ?label .
  OPTIONAL {
    ?iri <http://example.org/subtitle> ?subtitle .
  }
  ?iri <http://example.org/tag> ?tag .
  OPTIONAL {
    ?iri <http://example.org/altLabel> ?altLabel .
  }
}
