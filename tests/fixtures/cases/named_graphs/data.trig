@prefix ex: <http://example.org/> .

# Legacy backlog in the unnamed default graph: items accessioned before the
# consortium split its store into per-member graphs. The graph has no IRI, so
# no FROM clause can list it — it answers only when a query carries no read
# scope at all.
ex:item-legacy a ex:Item ;
    ex:title "Crate of unlabelled lantern slides" .

# The shared thesaurus graph — subject terms maintained centrally; every
# member's items link into it.
<urn:ex:thesaurus> {
    ex:subject-lighthouse a ex:Subject ;
        ex:name "Lighthouses" .

    ex:subject-shipwreck a ex:Subject ;
        ex:name "Shipwrecks" .
}

# The maritime museum's collection graph.
<urn:ex:maritime-museum> {
    ex:item-logbook a ex:Item ;
        ex:title "Lightkeeper's logbook, 1902" ;
        ex:subject ex:subject-lighthouse .

    ex:item-chart a ex:Item ;
        ex:title "Chart of the Merestone shoals" ;
        ex:subject ex:subject-shipwreck .
}

# The city archive's collection graph. It keeps a local copy of the Shipwrecks
# term — an exact duplicate of the thesaurus entry, so a scope listing both
# graphs still shows the term once: a merged default graph is one set of
# triples, not a pile of graphs.
<urn:ex:city-archive> {
    ex:item-ledger a ex:Item ;
        ex:title "Salvage ledger of the Anne" ;
        ex:subject ex:subject-shipwreck .

    ex:subject-shipwreck a ex:Subject ;
        ex:name "Shipwrecks" .
}
