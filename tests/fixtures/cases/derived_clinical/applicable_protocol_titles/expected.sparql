SELECT ?iri ?applicableProtocolTitles
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/clinical/Patient> .
  OPTIONAL {
    ?iri <http://example.org/clinical/appliesProtocol> ?protocol .
    ?protocol <http://example.org/clinical/title> ?title .
    BIND(?title AS ?applicableProtocolTitles)
  }
}
