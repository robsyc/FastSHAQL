SELECT ?iri ?activeConditions_iri ?activeConditions_mostSpecificClass
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/clinical/Patient> .
  OPTIONAL {
    {
      SELECT ?iri ?activeConditions_iri
      WHERE {
        ?iri <http://example.org/clinical/hasCondition> ?condition .
        BIND(?condition AS ?activeConditions_iri)
        FILTER(BOUND(?activeConditions_iri))
      }
    }
    ?activeConditions_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/clinical/Condition> .
    ?activeConditions_iri a ?cls .
    FILTER NOT EXISTS { ?activeConditions_iri a ?sub . ?sub <http://www.w3.org/2000/01/rdf-schema#subClassOf>+ ?cls . FILTER(?sub != ?cls) }
    BIND(STR(?cls) AS ?label)
    BIND(?label AS ?activeConditions_mostSpecificClass)
  }
}
