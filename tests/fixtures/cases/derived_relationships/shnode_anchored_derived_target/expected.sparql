SELECT ?iri ?name ?featuredEdition_iri ?featuredEdition_title
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/library/Member> .
  ?iri <http://example.org/library/name> ?name .
  OPTIONAL {
    {
      SELECT ?iri ?featuredEdition_iri
      WHERE {
        ?iri <http://example.org/library/sponsors> ?edition .
        ?edition a <http://example.org/library/SpecialCollection>, <http://example.org/library/RareBook> .
        BIND(?edition AS ?featuredEdition_iri)
        FILTER(BOUND(?featuredEdition_iri))
      }
    }
    ?featuredEdition_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/library/RareBook> .
    ?featuredEdition_iri <http://example.org/library/title> ?featuredEdition_title .
  }
}
