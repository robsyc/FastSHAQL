SELECT ?iri ?name ?featuredEdition_iri ?featuredEdition_title
WHERE {
  ?iri a <http://example.org/library/Member> .
  ?iri <http://example.org/library/name> ?name .
  OPTIONAL {
    ?iri <http://example.org/library/sponsors> ?edition .
    BIND(?edition AS ?featuredEdition_iri)
    ?featuredEdition_iri <http://example.org/library/title> ?featuredEdition_title .
  }
}
