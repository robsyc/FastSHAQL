SELECT ?iri ?homeBranch_iri ?homeBranch_name
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/library/Member> .
  OPTIONAL {
    BIND(<http://example.org/library/central> AS ?homeBranch_iri)
    ?homeBranch_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/library/Branch> .
    ?homeBranch_iri <http://example.org/library/name> ?homeBranch_name .
  }
}
