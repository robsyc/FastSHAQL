SELECT ?iri ?reviewedBooks_iri ?reviewedBooks_title
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/library/Member> .
  OPTIONAL {
    <http://example.org/library/Book> ^a ?reviewedBooks_iri .
    ?reviewedBooks_iri <http://example.org/library/review> ?reviewedBooks_iri_p0 .
    ?reviewedBooks_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/library/Book> .
    ?reviewedBooks_iri <http://example.org/library/title> ?reviewedBooks_title .
  }
}
