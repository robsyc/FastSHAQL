SELECT ?iri ?recommendedBooks_iri ?recommendedBooks_sameAuthorEditions_iri
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/library/Member> .
  OPTIONAL {
    {
      SELECT ?iri ?recommendedBooks_iri
      WHERE {
        ?iri <http://example.org/library/borrowed>/<http://example.org/library/author>/^<http://example.org/library/author> ?recommendedBooks_iri .
        ?recommendedBooks_iri <http://example.org/library/status> ?recommendedBooks_iri_p0 .
        FILTER(?recommendedBooks_iri_p0 = "available")
        FILTER(BOUND(?recommendedBooks_iri))
      }
    }
    ?recommendedBooks_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/library/Book> .
    OPTIONAL {
      {
        SELECT ?recommendedBooks_iri ?recommendedBooks_sameAuthorEditions_iri
        WHERE {
          ?recommendedBooks_iri <http://example.org/library/author>/^<http://example.org/library/author> ?recommendedBooks_sameAuthorEditions_iri .
          FILTER(BOUND(?recommendedBooks_sameAuthorEditions_iri))
        }
      }
      ?recommendedBooks_sameAuthorEditions_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/library/Book> .
    }
  }
}
