SELECT ?iri ?allBooks_iri ?allBooks_title
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/library/Member> .
  OPTIONAL {
    <http://example.org/library/Book> ^a ?allBooks_iri .
    ?allBooks_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/library/Book> .
    ?allBooks_iri <http://example.org/library/title> ?allBooks_title .
  }
}
