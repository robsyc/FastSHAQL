@prefix ex:  <http://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# The kiosk's content. Asserted values all conform to their shapes; the
# sidebar widget (ex:none-1) appears only as a derived constant, where no
# shape constraint reaches it.

ex:para-1 a ex:Paragraph ;
    ex:text "Intro paragraph" .

ex:img-1 a ex:Image ;
    ex:url "https://example.org/img-1.png" .

# Typed as both a Paragraph and an Image — the first declared member wins,
# and the other side stays hidden.
ex:both-1 a ex:Paragraph, ex:Image ;
    ex:text "Dual-typed block" ;
    ex:url "https://example.org/both.png" .

# A subclass of Paragraph carrying a nested author link.
ex:para-2 a ex:SubParagraph ;
    ex:text "Related paragraph" ;
    ex:author ex:person-1 .

ex:person-1 a ex:Person ;
    ex:name "Ada Lovelace" .

ex:para-3 a ex:Paragraph ;
    ex:text "Lead summary" .

ex:img-2 a ex:Image ;
    ex:url "https://example.org/img-2.png" .

# Matches no union member anywhere — only the derived picks reference it.
ex:none-1 a ex:Sidebar .

ex:photo-1 a ex:Photo ;
    ex:caption "Site photo" .

# Reaches the Asset lane through its superclass chain.
ex:vector-1 a ex:VectorPhoto ;
    ex:caption "Vector art" .

ex:video-1 a ex:Video ;
    ex:caption "Demo clip" .

ex:article-1 a ex:Article ;
    ex:title "Syntax highlights" ;
    ex:lead ex:para-1 ;
    ex:body ex:para-1, ex:img-1 ;
    ex:sidebar ex:para-3, ex:img-2 ;
    ex:spotlight ex:img-1, ex:photo-1 ;
    ex:closing ex:img-2 ;
    ex:asset ex:photo-1, ex:video-1 .

ex:article-2 a ex:Article ;
    ex:title "Dual types" ;
    ex:lead ex:img-1 ;
    ex:body ex:both-1 ;
    ex:spotlight ex:vector-1 ;
    ex:asset ex:vector-1 .

# Childless for every optional relationship — body, sidebar, spotlight,
# closing, and asset resolve to [] / null, never a missing key; the
# required lead still binds exactly one child.
ex:article-3 a ex:Article ;
    ex:title "Childless" ;
    ex:lead ex:para-3 .

# Class hierarchy — values reach their lane or binding through the
# superclass closure, never by listing every subclass.
ex:VectorPhoto rdfs:subClassOf ex:Photo .
ex:SubParagraph rdfs:subClassOf ex:Paragraph .
ex:Photo rdfs:subClassOf ex:Asset .
ex:Video rdfs:subClassOf ex:Asset .
