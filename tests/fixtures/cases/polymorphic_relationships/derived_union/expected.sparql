SELECT ?iri ?title ?related_iri ?related_member ?related_1_text ?related_2_url
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Article> .
  ?iri <http://example.org/title> ?title .
  OPTIONAL {
    {
      SELECT ?iri ?related_iri
      WHERE {
        VALUES ?related_iri {
          <http://example.org/para-2>
          <http://example.org/img-2>
          <http://example.org/none-1>
        }
        FILTER(BOUND(?related_iri))
      }
    }
    VALUES ?related_member {
      <http://example.org/Paragraph>
      <http://example.org/Image>
    }
    ?related_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?related_member .
    OPTIONAL {
      ?related_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Paragraph> .
      ?related_iri <http://example.org/text> ?related_1_text .
    }
    OPTIONAL {
      ?related_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Image> .
      ?related_iri <http://example.org/url> ?related_2_url .
    }
  }
}
