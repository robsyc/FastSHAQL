SELECT ?iri ?title ?picks_iri ?picks_member ?picks_1_text ?picks_2_url
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Article> .
  ?iri <http://example.org/title> ?title .
  OPTIONAL {
    {
      SELECT ?iri ?picks_iri
      WHERE {
        VALUES ?picks_iri {
          <http://example.org/para-2>
          <http://example.org/img-2>
          <http://example.org/none-1>
        }
        FILTER(BOUND(?picks_iri))
      }
    }
    VALUES ?picks_member {
      <http://example.org/Paragraph>
      <http://example.org/Image>
    }
    ?picks_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?picks_member .
    OPTIONAL {
      ?picks_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Paragraph> .
      ?picks_iri <http://example.org/text> ?picks_1_text .
    }
    OPTIONAL {
      ?picks_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Image> .
      ?picks_iri <http://example.org/url> ?picks_2_url .
    }
  }
}
