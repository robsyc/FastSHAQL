SELECT ?iri ?title ?body_iri ?body_member ?body_1_text ?body_2_url
WHERE {
  {
    SELECT DISTINCT ?iri
    WHERE {
      ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Article> .
    }
    ORDER BY ?iri
    LIMIT 2
  }
  ?iri <http://example.org/title> ?title .
  OPTIONAL {
    ?iri <http://example.org/body> ?body_iri .
    VALUES ?body_member {
      <http://example.org/Paragraph>
      <http://example.org/Image>
    }
    ?body_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?body_member .
    OPTIONAL {
      ?body_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Paragraph> .
      ?body_iri <http://example.org/text> ?body_1_text .
    }
    OPTIONAL {
      ?body_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Image> .
      ?body_iri <http://example.org/url> ?body_2_url .
    }
  }
}
