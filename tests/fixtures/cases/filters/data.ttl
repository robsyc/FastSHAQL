@prefix ex:  <http://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:amsterdam a ex:City ;
    ex:name "Amsterdam" ;
    ex:population 900000 .

ex:berlin a ex:City ;
    ex:name "Berlin" ;
    ex:population 3700000 .

ex:acme a ex:Company ;
    ex:name "Acme" ;
    ex:locatedIn ex:amsterdam .

ex:globex a ex:Company ;
    ex:name "Globex" ;
    ex:locatedIn ex:berlin .

ex:alice a ex:Person ;
    ex:name "Alice" ;
    ex:age 30 ;
    ex:active true ;
    ex:employer ex:acme ;
    ex:bio "Hello"@en , "Bonjour"@fr .

ex:bob a ex:Person ;
    ex:name "Bob" ;
    ex:age 25 ;
    ex:active false ;
    ex:employer ex:globex .

ex:carol a ex:Person ;
    ex:name "Carol" ;
    ex:age 35 ;
    ex:active true .
