SELECT ?iri ?title ?artist_iri ?artist_name ?artist_representedBy_iri ?artist_representedBy_name ?artist_representedBy_city
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Artwork> .
  ?iri <http://example.org/title> ?title .
  ?iri <http://example.org/artist> ?artist_iri .
  ?artist_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Artist> .
  ?artist_iri <http://example.org/name> ?artist_name .
  OPTIONAL {
    ?artist_iri <http://example.org/representedBy> ?artist_representedBy_iri .
    ?artist_representedBy_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Gallery> .
    ?artist_representedBy_iri <http://example.org/name> ?artist_representedBy_name .
    ?artist_representedBy_iri <http://example.org/city> ?artist_representedBy_city .
  }
  FILTER(EXISTS {
    ?artist_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Artist> .
    ?artist_iri <http://example.org/name> ?_rf_artist_name .
    FILTER(CONTAINS(?_rf_artist_name, "Monet"))
  })
}
