@prefix ex: <http://example.org/> .

# Catalog order follows the book IRIs alphabetically — frankenstein, good_omens,
# left_hand, middlemarch, mort, northanger, orlando, time_machine — and every
# page walks that order.

# 1 author x 4 subjects: Frankenstein alone spans four SPARQL rows.
ex:frankenstein a ex:Book ;
    ex:title "Frankenstein" ;
    ex:author ex:shelley ;
    ex:subject "Gothic", "Horror", "Monsters", "Science fiction" .

# 2 authors x 2 subjects: Good Omens spans four rows of its own.
ex:good_omens a ex:Book ;
    ex:title "Good Omens" ;
    ex:author ex:pratchett, ex:gaiman ;
    ex:subject "Fantasy", "Humor" .

ex:left_hand a ex:Book ;
    ex:title "The Left Hand of Darkness" ;
    ex:author ex:leguin ;
    ex:subject "Science fiction", "Gender" .

ex:middlemarch a ex:Book ;
    ex:title "Middlemarch" ;
    ex:author ex:eliot ;
    ex:subject "Victorian", "Domestic fiction" .

ex:mort a ex:Book ;
    ex:title "Mort" ;
    ex:author ex:pratchett ;
    ex:subject "Fantasy", "Humor" .

ex:northanger a ex:Book ;
    ex:title "Northanger Abbey" ;
    ex:author ex:austen ;
    ex:subject "Gothic", "Parody" .

ex:orlando a ex:Book ;
    ex:title "Orlando: A Biography" ;
    ex:author ex:woolf ;
    ex:subject "Modernism" .

ex:time_machine a ex:Book ;
    ex:title "The Time Machine" ;
    ex:author ex:wells ;
    ex:subject "Science fiction", "Utopia" .

ex:shelley a ex:Author ; ex:name "Mary Shelley" .
ex:pratchett a ex:Author ; ex:name "Terry Pratchett" .
ex:gaiman a ex:Author ; ex:name "Neil Gaiman" .
ex:leguin a ex:Author ; ex:name "Ursula K. Le Guin" .
ex:eliot a ex:Author ; ex:name "George Eliot" .
ex:austen a ex:Author ; ex:name "Jane Austen" .
ex:woolf a ex:Author ; ex:name "Virginia Woolf" .
ex:wells a ex:Author ; ex:name "H. G. Wells" .
