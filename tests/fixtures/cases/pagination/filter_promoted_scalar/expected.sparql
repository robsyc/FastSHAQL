SELECT ?iri ?name
WHERE {
  {
    SELECT DISTINCT ?iri
    WHERE {
      ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Person> .
      ?iri <http://example.org/title> ?title .
      FILTER(?title = "Engineer")
    }
    ORDER BY ?iri
    LIMIT 2
  }
  ?iri <http://example.org/name> ?name .
}
