SELECT ?iri ?title
WHERE {
  {
    SELECT DISTINCT ?iri
    WHERE {
      ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Book> .
      ?iri <http://example.org/title> ?title .
      FILTER(?title = "Orlando: A Biography")
    }
    ORDER BY ?iri
    LIMIT 1
  }
  ?iri <http://example.org/title> ?title .
}
