SELECT ?iri ?title ?composer_iri ?composer_name ?producer_iri ?producer_name ?houseCredits_iri ?houseCredits_name
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Album> .
  ?iri <http://example.org/title> ?title .
  OPTIONAL {
    ?iri <http://example.org/composer> ?composer_iri .
    ?composer_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Songwriter> .
    ?composer_iri <http://example.org/name> ?composer_name .
  }
  OPTIONAL {
    ?iri <http://example.org/producer> ?producer_iri .
    ?producer_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Producer> .
    ?producer_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Songwriter> .
    ?producer_iri <http://example.org/name> ?producer_name .
  }
  OPTIONAL {
    {
      SELECT ?iri ?houseCredits_iri
      WHERE {
        VALUES ?houseCredits_iri {
          <http://example.org/nina-1>
          <http://example.org/ray-1>
          <http://example.org/ivy-1>
        }
        FILTER(BOUND(?houseCredits_iri))
      }
    }
    ?houseCredits_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Producer> .
    ?houseCredits_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Songwriter> .
    ?houseCredits_iri <http://example.org/name> ?houseCredits_name .
  }
}
