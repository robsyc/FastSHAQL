SELECT ?iri ?title ?featured_iri ?featured_name ?note_iri ?note_text
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Album> .
  ?iri <http://example.org/title> ?title .
  OPTIONAL {
    ?iri <http://example.org/featured> ?featured_iri .
    ?featured_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Artist> .
    ?featured_iri <http://example.org/name> ?featured_name .
  }
  OPTIONAL {
    ?iri <http://example.org/note> ?note_iri .
    ?note_iri <http://example.org/text> ?note_text .
  }
}
