SELECT ?iri ?name ?address_iri ?address_street ?note_iri ?note_text
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Customer> .
  ?iri <http://example.org/name> ?name .
  OPTIONAL {
    ?iri <http://example.org/address> ?address_iri .
    ?address_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/PostalAddress> .
    ?address_iri <http://example.org/street> ?address_street .
  }
  OPTIONAL {
    ?iri <http://example.org/note> ?note_iri .
    ?note_iri <http://example.org/text> ?note_text .
  }
}
