@prefix ex:   <http://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# The label's catalog. Every asserted link conforms to its shapes; the
# house trio rides only the derived constant lane, where the binding
# typing still reaches it.

# Credited people. cleo-1 reaches the featured list through her
# superclass; horn-1 is untyped — the borrowed Artist typing drops him.
ex:nina-1 a ex:Artist ;
    ex:name "Nina Vale" .

ex:cleo-1 a ex:Vocalist ;
    ex:name "Cleo Marsh" .

ex:horn-1 ex:name "Guest Horn" .

# ray-1 carries songwriter credit only — no Artist type — and still
# resolves as a composer: declared classes replace the borrowed typing.
# ivy-1 carries both credits the producer link demands.
ex:ray-1 a ex:Songwriter ;
    ex:name "Ray Okuda" .

ex:ivy-1 a ex:Songwriter , ex:Producer ;
    ex:name "Ivy Stone" .

ex:album-1 a ex:Album ;
    ex:title "Blue Portal" ;
    ex:featured ex:nina-1 , ex:cleo-1 ;
    ex:composer ex:ray-1 ;
    ex:producer ex:ivy-1 ;
    ex:note ex:note-1 .

# No composer or producer on record — both resolve to null — and the
# only featured link points at the untyped guest, so the list is empty.
ex:album-2 a ex:Album ;
    ex:title "Night Ferry" ;
    ex:featured ex:horn-1 ;
    ex:note ex:note-2 .

# Sleeve notes: never typed in the data — the class-less note link
# takes them as they are.
ex:note-1 ex:text "Recorded live over two November nights." .
ex:note-2 ex:text "A single take with the studio window open." .

ex:Vocalist rdfs:subClassOf ex:Artist .
