@prefix ex:    <http://example.org/> .
@prefix city:  <http://example.org/city/> .
@prefix state: <http://example.org/state/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

# The program's readings. Every coded value sits inside its sh:in list; the
# twice-listed "verified" code is as legal as any other member. The pH
# reading is the sparse one — no grade, no flags, no credited analyst.

ex:reading-101 a ex:Reading ;
    ex:parameter "Dissolved oxygen" ;
    ex:result 7.4 ;
    ex:reportingLimit 5.0 ;
    ex:comparator ">" ;
    ex:status "collected" ;
    ex:site city:main-outfall ;
    ex:grade 1 ;
    ex:flags "estimated", "held" ;
    ex:analyst ex:ana-morgan .

ex:reading-202 a ex:Reading ;
    ex:parameter "Escherichia coli" ;
    ex:result 41.0 ;
    ex:reportingLimit 100.0 ;
    ex:comparator "<" ;
    ex:status "in-lab" ;
    ex:site state:main-outfall ;
    ex:grade 2 ;
    ex:analyst ex:ana-lee .

ex:reading-203 a ex:Reading ;
    ex:parameter "pH" ;
    ex:result 6.5 ;
    ex:reportingLimit 6.5 ;
    ex:comparator "<=" ;
    ex:status "verified" ;
    ex:site city:north-pier ;
    ex:flags "below-detection" .

ex:reading-304 a ex:Reading ;
    ex:parameter "Turbidity" ;
    ex:result 3.9 ;
    ex:reportingLimit 1.0 ;
    ex:comparator ">=" ;
    ex:status "entered-in-error" ;
    ex:site city:main-outfall ;
    ex:grade 3 ;
    ex:flags "estimated" ;
    ex:analyst ex:ana-morgan .

ex:ana-morgan a ex:Analyst ;
    ex:name "Morgan Reid" .

ex:ana-lee a ex:Analyst ;
    ex:name "Lee Chen" .

# The merged station list — two agencies, one shared local name.
city:main-outfall rdfs:label "City main outfall" .
state:main-outfall rdfs:label "State main outfall" .
city:north-pier rdfs:label "North pier" .
