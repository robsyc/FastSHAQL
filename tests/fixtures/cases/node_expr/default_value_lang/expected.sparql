SELECT ?iri ?displayName
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/genomics/Gene> .
  OPTIONAL {
    ?iri <http://example.org/genomics/displayName> ?_l0_displayName .
    FILTER(langMatches(LANG(?_l0_displayName), "en"))
  }
  BIND(COALESCE(?_l0_displayName, "unnamed") AS ?displayName)
}
