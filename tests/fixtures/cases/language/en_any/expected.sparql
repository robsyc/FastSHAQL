SELECT ?iri ?name ?bio ?altLabel ?note ?plain ?summary ?employer_iri ?employer_label
WHERE {
  ?iri a <http://example.org/Person> .
  OPTIONAL {
    ?iri <http://example.org/name> ?_l0_name .
    FILTER(langMatches(LANG(?_l0_name), "en"))
  }
  OPTIONAL {
    ?iri <http://example.org/name> ?_l1_name .
    FILTER(langMatches(LANG(?_l1_name), "*"))
  }
  BIND(COALESCE(?_l0_name, ?_l1_name) AS ?name)
  FILTER(BOUND(?name))
  OPTIONAL {
    ?iri <http://example.org/bio> ?_l0_bio .
    FILTER(langMatches(LANG(?_l0_bio), "en"))
  }
  OPTIONAL {
    ?iri <http://example.org/bio> ?_l1_bio .
    FILTER(langMatches(LANG(?_l1_bio), "*"))
  }
  BIND(COALESCE(?_l0_bio, ?_l1_bio) AS ?bio)
  OPTIONAL {
    ?iri <http://example.org/altLabel> ?altLabel .
    FILTER(langMatches(LANG(?altLabel), "en") || langMatches(LANG(?altLabel), "*"))
  }
  OPTIONAL {
    ?iri <http://example.org/note> ?_l0_note .
    FILTER(langMatches(LANG(?_l0_note), "en"))
  }
  OPTIONAL {
    ?iri <http://example.org/note> ?_l1_note .
    FILTER(langMatches(LANG(?_l1_note), "*"))
  }
  OPTIONAL {
    ?iri <http://example.org/note> ?_l2_note .
    FILTER(LANG(?_l2_note) = "")
  }
  BIND(COALESCE(?_l0_note, ?_l1_note, ?_l2_note) AS ?note)
  OPTIONAL {
    ?iri <http://example.org/plain> ?plain .
  }
  OPTIONAL {
    ?iri <http://example.org/summarySource> ?_l0_summary .
    FILTER(langMatches(LANG(?_l0_summary), "en"))
  }
  OPTIONAL {
    ?iri <http://example.org/summarySource> ?_l1_summary .
    FILTER(langMatches(LANG(?_l1_summary), "*"))
  }
  BIND(COALESCE(?_l0_summary, ?_l1_summary) AS ?summary)
  OPTIONAL {
    ?iri <http://example.org/employer> ?employer_iri .
    ?employer_iri a <http://example.org/Org> .
    OPTIONAL {
      ?employer_iri <http://example.org/label> ?_l0_employer_label .
      FILTER(langMatches(LANG(?_l0_employer_label), "en"))
    }
    OPTIONAL {
      ?employer_iri <http://example.org/label> ?_l1_employer_label .
      FILTER(langMatches(LANG(?_l1_employer_label), "*"))
    }
    BIND(COALESCE(?_l0_employer_label, ?_l1_employer_label) AS ?employer_label)
  }
}
