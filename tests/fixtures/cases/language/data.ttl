@prefix ex: <http://example.org/> .

# The collection. Labels were authored by different departments and eras:
# English and Dutch wall text, an American-English touring label, a
# French-only loan, and registry plain text where nobody declared a
# language. Every artwork conforms to its shape — the languages are the
# story.

# Fully populated in English, aliases in three languages.
ex:watch a ex:Artwork ;
    ex:title "The Night Watch"@en ;
    ex:caption "A militia company under Captain Banning Cocq"@en ;
    ex:altTitle "The Shooting Company of Frans Banning Cocq"@en ,
                "Militia Company of District II"@en ,
                "De Nachtwacht"@nl ;
    ex:inventoryNumber "SK-C-5" ;
    ex:marketingLine "Rembrandt's masterpiece of light and shadow"@en ;
    ex:artist ex:rembrandt .

ex:rembrandt a ex:Artist ;
    ex:name "Rembrandt van Rijn"@en .

# The American-labelled tour: every text in en-US, a Dutch alias, and an
# artist named in Dutch only.
ex:sunflowers a ex:Artwork ;
    ex:title "The Sunflowers"@en-US ;
    ex:caption "Vase with fifteen sunflowers"@en-US ;
    ex:altTitle "De Zonnebloemen"@nl ;
    ex:inventoryNumber "SK-A-188" ;
    ex:marketingLine "Van Gogh's sunlit yellows"@en-US ;
    ex:artist ex:vincent .

ex:vincent a ex:Artist ;
    ex:name "Vincent van Gogh"@nl .

# Dutch throughout.
ex:milkmaid a ex:Artwork ;
    ex:title "Het melkmeisje"@nl ;
    ex:caption "Een keukenmeid schenkt melk uit"@nl ;
    ex:inventoryNumber "SK-A-2344" ;
    ex:marketingLine "Vermeers stille keuken"@nl ;
    ex:artist ex:johannes .

ex:johannes a ex:Artist ;
    ex:name "Johannes Vermeer"@nl .

# Sparse: the required title, the inventory number, and one plain loan
# note on the union caption — every other field resolves to null.
ex:great-wave a ex:Artwork ;
    ex:title "The Great Wave off Kanagawa"@en ;
    ex:caption "On loan from a private collection" ;
    ex:inventoryNumber "P-1831" .

# The sentinel entity: a Dutch title, a French alias, and plain registry
# text on the marketing line (the teaser's source).
ex:delft-vase a ex:Artwork ;
    ex:title "Delftware vase"@nl ;
    ex:altTitle "Vase de Delft"@fr ;
    ex:inventoryNumber "BK-1745" ;
    ex:marketingLine "Highlight of the ceramics room" .

# French-only loan with its French-named artist.
ex:liberty a ex:Artwork ;
    ex:title "La Liberté guidant le peuple"@fr ;
    ex:caption "Juillet 1830 sur les barricades"@fr ;
    ex:inventoryNumber "SK-A-1284" ;
    ex:marketingLine "L'étendard de la révolution"@fr ;
    ex:artist ex:eugene .

ex:eugene a ex:Artist ;
    ex:name "Eugène Delacroix"@fr .
