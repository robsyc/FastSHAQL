SELECT ?iri ?title ?caption ?altTitle ?inventoryNumber ?teaser ?artist_iri ?artist_name
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Artwork> .
  OPTIONAL {
    ?iri <http://example.org/title> ?_l0_title .
    FILTER(langMatches(LANG(?_l0_title), "en-us"))
  }
  BIND(COALESCE(?_l0_title) AS ?title)
  FILTER(BOUND(?title))
  OPTIONAL {
    ?iri <http://example.org/caption> ?_l0_caption .
    FILTER(langMatches(LANG(?_l0_caption), "en-us"))
  }
  OPTIONAL {
    ?iri <http://example.org/caption> ?_l1_caption .
    FILTER(LANG(?_l1_caption) = "")
  }
  BIND(COALESCE(?_l0_caption, ?_l1_caption) AS ?caption)
  OPTIONAL {
    ?iri <http://example.org/altTitle> ?altTitle .
    FILTER(langMatches(LANG(?altTitle), "en-us"))
  }
  ?iri <http://example.org/inventoryNumber> ?inventoryNumber .
  OPTIONAL {
    ?iri <http://example.org/marketingLine> ?_l0_teaser .
    FILTER(langMatches(LANG(?_l0_teaser), "en-us"))
  }
  BIND(COALESCE(?_l0_teaser) AS ?teaser)
  OPTIONAL {
    ?iri <http://example.org/artist> ?artist_iri .
    ?artist_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/Artist> .
    OPTIONAL {
      ?artist_iri <http://example.org/name> ?_l0_artist_name .
      FILTER(langMatches(LANG(?_l0_artist_name), "en-us"))
    }
    BIND(COALESCE(?_l0_artist_name) AS ?artist_name)
    FILTER(BOUND(?artist_name))
  }
}
