SELECT ?iri ?label ?iriLength
WHERE {
  ?iri a <http://example.org/Item> .
  ?iri <http://example.org/givenName> ?given .
  ?iri <http://example.org/familyName> ?family .
  BIND(CONCAT(?given, " ", ?family) AS ?label)
  BIND(STRLEN(STR(?iri)) AS ?iriLength)
  FILTER(CONTAINS(?label, "Industry") && ?iriLength > "30"^^<http://www.w3.org/2001/XMLSchema#integer>)
}
