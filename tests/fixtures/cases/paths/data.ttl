@prefix ex: <http://example.org/> .

# The archive. Three Dune Drifter films chained backwards (each points at its
# predecessor) and one self-distributed standalone; the people, works,
# countries, and distributors around them.

ex:drifter-1 a ex:Movie ;
    ex:title "Dune Drifter" ;
    ex:director ex:jin ;
    ex:cast ex:tomas, ex:ade ;
    ex:distributor ex:halcyon ;
    ex:adaptedFrom ex:novel-1 .

ex:drifter-2 a ex:Movie ;
    ex:title "Dune Drifter II" ;
    ex:director ex:marisol ;
    ex:distributor ex:kite ;
    ex:inspiredBy ex:poem-1 ;
    ex:predecessor ex:drifter-1 .

# The same novel both ways — a faithful adaptation and a loose inspiration.
ex:drifter-3 a ex:Movie ;
    ex:title "Dune Drifter III" ;
    ex:director ex:marisol ;
    ex:distributor ex:kite ;
    ex:adaptedFrom ex:novel-2 ;
    ex:inspiredBy ex:novel-2 ;
    ex:predecessor ex:drifter-2 .

# Self-distributed: no distributor, no cast, no source material — every
# optional walk off it answers null or an empty list.
ex:meridian a ex:Movie ;
    ex:title "Meridian" ;
    ex:director ex:jin .

# Jin direct(ed) two films; Marisol took over the sequels. Tomás keeps both
# mailboxes; Ade keeps none and routes licences through Inés, who is herself
# represented by Luca — a second hop that stays invisible from Ade.
ex:jin a ex:Person ;
    ex:name "Jin Okabe" ;
    ex:workEmail "jin@archive.example" .

ex:marisol a ex:Person ;
    ex:name "Marisol Vega" ;
    ex:personalEmail "marisol@post.example" .

ex:tomas a ex:Person ;
    ex:name "Tomás Reyes" ;
    ex:workEmail "tomas@archive.example" ;
    ex:personalEmail "tomas@post.example" .

ex:ade a ex:Person ;
    ex:name "Ade Okafor" ;
    ex:agent ex:ines .

ex:ines a ex:Person ;
    ex:name "Inés Carballo" ;
    ex:agent ex:luca .

ex:luca a ex:Person ;
    ex:name "Luca Ferrara" .

# Distributors: middle nodes with no rdf:type and no shape of their own —
# only ever walked through, never queried directly.
ex:halcyon
    ex:name "Halcyon Pictures" ;
    ex:country ex:france .

ex:kite
    ex:name "Kite Releasing" ;
    ex:country ex:japan .

ex:novel-1 a ex:Work ;
    ex:title "The Drifter's Almanac" .

ex:poem-1 a ex:Work ;
    ex:title "Salt and Glass" .

ex:novel-2 a ex:Work ;
    ex:title "Waystation Blues" .

ex:france a ex:Country ;
    ex:name "France" .

ex:japan a ex:Country ;
    ex:name "Japan" .
