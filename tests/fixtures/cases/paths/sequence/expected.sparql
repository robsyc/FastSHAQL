SELECT ?iri ?name ?employerCity_iri ?employerCity_name
WHERE {
  ?iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/EmployerCityPerson> .
  ?iri <http://example.org/name> ?name .
  OPTIONAL {
    ?iri <http://example.org/employer>/<http://example.org/locatedIn> ?employerCity_iri .
    ?employerCity_iri a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <http://example.org/City> .
    ?employerCity_iri <http://example.org/name> ?employerCity_name .
  }
}
