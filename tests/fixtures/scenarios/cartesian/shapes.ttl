@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ChildShape a sh:NodeShape ;
    sh:codeIdentifier "Child" ;
    sh:targetClass ex:Child ;
    sh:property [
        sh:path ex:tag ;
        sh:codeIdentifier "tag" ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path ex:altLabel ;
        sh:codeIdentifier "altLabel" ;
        sh:datatype xsd:string ;
    ] .

ex:ThingShape a sh:NodeShape ;
    sh:codeIdentifier "Thing" ;
    sh:targetClass ex:Thing ;
    sh:property [
        sh:path ex:tag ;
        sh:codeIdentifier "tag" ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path ex:altLabel ;
        sh:codeIdentifier "altLabel" ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path ex:hasChild ;
        sh:codeIdentifier "hasChild" ;
        sh:class ex:Child ;
    ] .
